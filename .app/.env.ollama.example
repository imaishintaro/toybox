# ── Ollama ローカル LLM 設定 ──────────────────────────────────────
# Ollama がインストール・起動済みであることを前提とします
# https://ollama.com/

AI_PROVIDER=ollama

# 使用するモデル（デフォルト: llama3.2）
# ツール呼び出し（function calling）に対応したモデルが必要です
# 対応モデル例:
#   llama3.3          llama3.2
#   qwen2.5-coder     mistral-nemo
# モデルの事前ダウンロード: ollama pull llama3.3
OLLAMA_MODEL=llama3.3

# Ollama のエンドポイント（デフォルトのまま変更不要）
# OLLAMA_BASE_URL=http://localhost:11434/v1

# エージェントループの最大反復回数（デフォルト: 20）
MAX_ITERATIONS=20

# 作業ディレクトリ（省略するとカレントディレクトリ）
# WORK_DIR=/path/to/your/project

# ── 埋め込みモデル設定（コンテキスト圧縮用・省略可） ───────────────
# ローカル LLM では埋め込みに OpenRouter を利用する場合のみ設定
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_PROVIDER=openrouter
