# ── Azure OpenAI 設定 ─────────────────────────────────────────────
# Azure ポータルでリソースを作成し、APIキーとエンドポイントを取得してください

# Azure OpenAI APIキー（必須）
AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI エンドポイント（必須）
# 例: https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# デプロイメント名（必須）
# Azure ポータルで作成したデプロイメント名を指定してください
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# API バージョン（省略時: 2024-02-01）
# AZURE_OPENAI_API_VERSION=2024-02-01

# エージェントループの最大反復回数（デフォルト: 20）
MAX_ITERATIONS=20

# 作業ディレクトリ（省略するとカレントディレクトリ）
# WORK_DIR=/path/to/your/project
